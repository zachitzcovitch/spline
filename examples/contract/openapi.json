                ],
                "type": "object"
              },
              "kind": {
                "const": "invalid_name",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "details"
            ],
            "type": "object"
          }
        ]
      },
      "NewUser": {
        "additionalProperties": false,
        "description": "Information supplied when creating a user.",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "displayName"
        ],
        "type": "object"
      },
      "ReplaceUser": {
        "additionalProperties": false,
        "description": "Complete replacement of the writable profile. An absent bio becomes null.",
        "properties": {
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "displayName"
        ],
        "type": "object"
      },
      "ServiceError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "kind": {
            "const": "framework",
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "code",
          "message"
        ],
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "description": "A public user record.",
        "properties": {
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "displayName": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          }
        },
        "required": [
          "id",
          "displayName",
          "bio"
        ],
        "type": "object"
      },
      "UserId": {
        "type": "string"
      },
      "UserPatch": {
        "additionalProperties": false,
        "description": "Partial update: omitted fields stay unchanged; null clears the nullable bio.",
        "properties": {
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "displayName": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
